<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Installation des mises à jour de Bulle (APK hors Play Store) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Exemption d'optimisation de la batterie (indispensable sur MagicOS) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Optionnelle, accordée uniquement via adb : réactivation auto de l'accessibilité -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Module Alertes système (modules/alerts) : les permissions d'exécution
         ne sont demandées qu'à l'activation de l'alerte concernée. -->
    <!-- Wi-Fi : état du réseau ; le nom (SSID) exige en plus la localisation précise. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Bluetooth : appareils connectés et leur batterie. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Captures d'écran : lecture des images (Android 13+ / Android 12). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Applis installées : nom et icône (distribution hors Play Store). -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Passage en 5G (TelephonyCallback.DisplayInfoListener), demandée à l'activation de l'alerte.
         Réseau mobile, VPN, point d'accès, son, USB, caméra et micro utilisés : aucune permission. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Module Agenda (modules/calendar) : lecture locale de l'agenda, demandée à l'activation. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Module Météo (modules/weather) : INTERNET et ACCESS_COARSE_LOCATION (position approximative,
         demandée à l'activation) sont déjà déclarées plus haut. -->

    <!-- Module Volet, réglages rapides (modules/volet/qs) -->
    <!-- Ne pas déranger : indispensable pour figurer dans « Accès Ne pas déranger ». -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Rotation auto, luminosité (accordée par l'utilisateur dans « Modifier les paramètres système »). -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Module Musique (modules/music) : visualiseur audio réel, OPTIONNEL et désactivé par défaut.
         RECORD_AUDIO n'est demandée qu'à l'activation de l'option : le Visualizer ne lit que des
         amplitudes (FFT) en mémoire, rien n'est enregistré ni envoyé. MODIFY_AUDIO_SETTINGS (permission
         normale) est exigée par Android pour un Visualizer sur la sortie globale (session audio 0). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Module Minuteur (modules/focus) : vibration légère en fin de phase (permission normale). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Module Temps d'écran (modules/screentime) : « Accès aux données d'utilisation », permission
         spéciale accordée par l'utilisateur dans les paramètres (UsageStatsManager, lecture locale). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Zone capture (modules/capture) : scanner QR, mémo vocal, enregistreur d'écran.
         CAMERA : demandée par le scanner QR à son ouverture (analyse locale, aucune image gardée).
         RECORD_AUDIO (déclarée plus haut) : demandée au premier mémo / à l'activation du son micro.
         Types de service de premier plan : micro (mémo, son de l'enregistrement d'écran) et
         mediaProjection (enregistrement d'écran, consentement système à chaque fois). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- API d'intégration (modules/external, docs/INTEGRATION.md): permission que doivent demander
         les applis qui poussent du contenu dans l'île. Accordée aux applis signées avec la même clé
         que Bulle, ou dont le certificat figure dans res/values/arrays_known_certs.xml (Android 12+). -->
    <permission
        android:name="com.karelisio.bulle.permission.SHOW"
        android:description="@string/ext_permission_description"
        android:knownCerts="@array/bulle_known_certs"
        android:label="@string/ext_permission_label"
        android:protectionLevel="signature|knownSigner" />
    <!-- Bulle détient aussi sa propre permission : les applis Karelisio peuvent ainsi protéger
         leurs receivers (SEND_THOUGHT, CRAVING, REQUEST_FUEL) pour n'accepter que Bulle. -->
    <uses-permission android:name="com.karelisio.bulle.permission.SHOW" />

    <!-- Applis lançables et raccourcis d'applis (gestes, recherche, Deck) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CREATE_SHORTCUT" />
        </intent>
    </queries>

    <application
        android:name=".BulleApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bulle.Splash">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Module Musique : paroles plein écran « karaoké », lancées depuis l'île (nouvelle tâche à part,
             absente des applis récentes pour ne pas mêler la vue à l'appli de réglages). -->
        <activity
            android:name=".modules.music.karaoke.KaraokeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.karelisio.bulle.karaoke"
            android:theme="@style/Theme.Bulle" />

        <!-- Zone capture (modules/capture) -->
        <!-- Scanner QR plein écran (tâche à part, absente des applis récentes). -->
        <activity
            android:name=".modules.capture.qr.QrScanActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.karelisio.bulle.capture"
            android:theme="@style/Theme.Bulle.Capture.Scanner" />
        <!-- Activités transparentes : permission micro (mémo) et consentement MediaProjection. -->
        <activity
            android:name=".modules.capture.memo.MemoStartActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.karelisio.bulle.capture"
            android:theme="@style/Theme.Bulle.Capture.Transparent" />
        <activity
            android:name=".modules.capture.recorder.ScreenRecordActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.karelisio.bulle.capture"
            android:theme="@style/Theme.Bulle.Capture.Transparent" />
        <!-- Mémo vocal (micro) et enregistrement d'écran (mediaProjection, + micro si le son est activé). -->
        <service
            android:name=".modules.capture.memo.MemoService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <service
            android:name=".modules.capture.recorder.ScreenRecordService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />
        <!-- Partage des mémos vocaux (fichiers privés). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.capture.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/capture_file_paths" />
        </provider>

        <!-- L'île : overlay d'accessibilité -->
        <service
            android:name=".island.IslandAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <!-- Notifications et sessions média -->
        <service
            android:name=".notifications.BulleNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Maintien en vie -->
        <service
            android:name=".system.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the system overlay (Dynamic Island) alive on devices that kill background apps aggressively." />
        </service>

        <!-- Tuile Réglages rapides -->
        <service
            android:name=".system.IslandTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_bulle"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <receiver
            android:name=".system.BootReceiver"
            android:directBootAware="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- API d'intégration (modules/external) : exporté, mais réservé aux applis détenant
             la permission SHOW (signature ou certificat connu). -->
        <receiver
            android:name=".modules.external.ExternalReceiver"
            android:exported="true"
            android:permission="com.karelisio.bulle.permission.SHOW">
            <intent-filter>
                <action android:name="com.karelisio.bulle.action.SHOW" />
                <action android:name="com.karelisio.bulle.action.UPDATE" />
                <action android:name="com.karelisio.bulle.action.DISMISS" />
            </intent-filter>
        </receiver>

        <!-- Statut de la session PackageInstaller (mise à jour in-app) -->
        <receiver
            android:name=".core.update.InstallStatusReceiver"
            android:exported="false" />

        <!-- WorkManager initialisé à la demande (BulleApp est un Configuration.Provider) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Shizuku (facultatif) : reçoit le binder de Shizuku pour les bascules système du Volet. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Langue par appli (Android 13+) sur Android 12 -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
