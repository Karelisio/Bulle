<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:name="main"
                android:pivotX="54"
                android:pivotY="56"
                android:scaleX="0"
                android:scaleY="0">
                <path
                    android:fillColor="#332F5BD8"
                    android:strokeColor="#FF2F5BD8"
                    android:strokeWidth="3"
                    android:pathData="M54,38a18,18 0,1 1,0 36a18,18 0,1 1,0 -36z" />
                <path
                    android:strokeColor="#FF4F7BFF"
                    android:strokeWidth="3"
                    android:strokeLineCap="round"
                    android:pathData="M42.5,53a12,12 0,0 1,8.5 -9" />
            </group>
            <group
                android:name="drop"
                android:pivotX="54"
                android:pivotY="56"
                android:translateX="0"
                android:translateY="0"
                android:scaleX="0"
                android:scaleY="0">
                <path
                    android:fillColor="#FF6A3FD0"
                    android:pathData="M54,51a5,5 0,1 1,0 10a5,5 0,1 1,0 -10z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="main">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:duration="450"
                    android:valueFrom="0" android:valueTo="1"
                    android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:duration="450"
                    android:valueFrom="0" android:valueTo="1"
                    android:interpolator="@android:anim/overshoot_interpolator" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="drop">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:startOffset="250" android:duration="300"
                    android:valueFrom="0" android:valueTo="1" />
                <objectAnimator android:propertyName="scaleY" android:startOffset="250" android:duration="300"
                    android:valueFrom="0" android:valueTo="1" />
                <objectAnimator android:propertyName="translateX" android:startOffset="300" android:duration="400"
                    android:valueFrom="0" android:valueTo="24"
                    android:interpolator="@android:anim/decelerate_interpolator" />
                <objectAnimator android:propertyName="translateY" android:startOffset="300" android:duration="400"
                    android:valueFrom="0" android:valueTo="-24"
                    android:interpolator="@android:anim/decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
