    <string name="perm_accessibility">Accessibilité</string>
    <string name="perm_accessibility_why">Affiche l’île par-dessus les autres applis et détecte le plein écran. Bulle ne lit pas le contenu de vos écrans.</string>
    <string name="perm_listener">Accès aux notifications</string>
    <string name="perm_listener_why">Transforme vos notifications, appels et lectures musicales en activités dans l’île.</string>
    <string name="perm_notifications">Notifications</string>
    <string name="perm_notifications_why">Notification discrète du service qui garde l’île en vie.</string>
    <string name="perm_install">Installation d’applis</string>
    <string name="perm_install_why">Installe les mises à jour de Bulle téléchargées depuis GitHub, après votre confirmation.</string>
    <string name="perm_battery">Optimisation de la batterie</string>
    <string name="perm_battery_why">Évite que le système n’arrête l’île en arrière-plan.</string>
    <string name="perm_bluetooth">Bluetooth</string>
    <string name="perm_bluetooth_why">Alerte de connexion d’écouteurs et niveau de batterie des appareils.</string>
    <string name="perm_location">Localisation</string>
    <string name="perm_location_why">Exigée par Android pour lire le nom du réseau Wi-Fi. Votre position n’est jamais utilisée.</string>
    <string name="perm_images">Images</string>
    <string name="perm_images_why">Détecte les nouvelles captures d’écran pour en afficher l’aperçu.</string>
    <string name="perm_write_settings">Modification des réglages système</string>
    <string name="perm_write_settings_why">Gestes qui changent la luminosité, la rotation ou d’autres réglages.</string>
    <string name="perm_secure_settings">Réglages sécurisés (adb)</string>
    <string name="perm_secure_settings_why">Optionnelle : réactive automatiquement le service d’accessibilité s’il est coupé. Accordée uniquement via adb ; pour la retirer :</string>
    <string name="perm_internet">Internet</string>
    <string name="perm_internet_why">Uniquement pour les paroles synchronisées (LRCLIB) et la recherche de mises à jour (GitHub). Aucune autre donnée n’est envoyée.</string>
